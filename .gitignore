# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
service-account*.json
gcp-key*.json

# ── Python ────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
dist/
build/
*.egg-info/
.eggs/
.pytest_cache/

